  <SQLScript>--LINKNOGROUP
-- 说明：表名/列名为占位，请按实际推送结果表调整。
DECLARE @MFGNUM VARCHAR(30) = '{0}';

SELECT EXTERNALCODE AS ExternalCode
  , CASE PUSHSTATUS WHEN 1 THEN '成功' WHEN 2 THEN '失败' ELSE '待推送' END AS PushStatus
  , YONYOUCODE AS YonyouCode
  , YONYOUID AS YonyouId
  , PUSHERRMSG AS Error
  , PUSHTIME AS PushTime
  , CASE WHEN PUSHSTATUS = 1 THEN 'H03' END LINKAPPRROW
FROM TSALESORDER
WHERE MFGNUM = @MFGNUM
ORDER BY EXTERNALCODE</SQLScript>
