  <ChartType />
  <SQLScript>--LINKNOGROUP
DECLARE @MFGNUM VARCHAR(30) = '{0}';
DECLARE @MFBLIN INT = 0{1};
DECLARE @YARNGRP VARCHAR(30) = '{2}';

SELECT [RESNUM]
      ,[RESFLG]
      ,[STRX1] X1
      ,[STRX2] X2
      ,[STRX3] X3
      ,CAST([CUMVAR] AS DECIMAL(18,4)) CUMVAR
      ,[COLSHOA] [COLDESA]
      ,[COLSHOB] [COLDESB]
      ,[COLSHOC] [COLDESC]
      ,[COLSHOD] [COLDESD]
      ,[COLSHOE] [COLDESE]
      ,[COLSHOF] [COLDESF]
      ,[COLSHOG] [COLDESG]
      ,[COLSHOH] [COLDESH]
      ,[CREUSR]
      ,[CRETIM]
      ,CASE WHEN [RESFLG]=1 THEN 'H03' END LINKAPPRROW
FROM [MFGMATBTS]
WHERE MFGNUM = @MFGNUM
  AND MFBLIN = @MFBLIN
  AND YARNGRP = @YARNGRP;</SQLScript>
